# ========================================
# 策略选股池系统 - 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ========================================

# ----------------------------------------
# 必需配置
# ----------------------------------------

# 飞书 Webhook URL（日报发送）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# 数据库路径（默认: data/portfolio.duckdb）
DB_PATH=data/portfolio.db

# ----------------------------------------
# 可选配置
# ----------------------------------------

# Claude API Key（AI健康监测，可选）
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# Tushare Token（备选数据源，可选）
TUSHARE_TOKEN=your_token_here

# InStock MySQL 配置（如果使用InStock）
INSTOCK_MYSQL_HOST=localhost
INSTOCK_MYSQL_PORT=3306
INSTOCK_MYSQL_USER=root
INSTOCK_MYSQL_PASSWORD=your_password
INSTOCK_MYSQL_DATABASE=instockdb

# ----------------------------------------
# 系统配置
# ----------------------------------------

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/run.log

# 数据缓存目录
CACHE_DIR=data/cache

# 缓存过期时间（秒，默认1小时）
CACHE_EXPIRE_SECONDS=3600

# AkShare 代理（Clash Verge 默认 HTTP 端口）
AKSHARE_PROXY_URL=http://127.0.0.1:7897

# InStock 代理（可选；留空表示直连）
INSTOCK_PROXY_URL=

# InStock / 东方财富 Cookie（可选但推荐）
INSTOCK_EASTMONEY_COOKIE=

# ----------------------------------------
# 策略参数
# ----------------------------------------

# 初始资金（每策略，默认20万）
INITIAL_CAPITAL=200000.0

# 最低股价（过滤低价股，默认2元）
MIN_STOCK_PRICE=2.0

# 交易成本 - 股票
STOCK_BUY_COMMISSION_RATE=0.00012
STOCK_SELL_COMMISSION_RATE=0.00012
STAMP_DUTY_RATE=0.001
TRANSFER_FEE_RATE=0.00002
MIN_COMMISSION=5.0

# 交易成本 - ETF
ETF_BUY_COMMISSION_RATE=0.00012
ETF_SELL_COMMISSION_RATE=0.00012

# ----------------------------------------
# 功能开关
# ----------------------------------------

# 启用AI健康监测
ENABLE_AI_ANALYSIS=false

# 启用Web仪表板
ENABLE_DASHBOARD=true

# 使用InStock作为主要数据源
USE_INSTOCK=false

# 调试模式
DEBUG=false
