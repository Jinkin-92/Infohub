# Stock strategy pool runtime environment example
# Copy the values you need into .env.

DB_PATH=data/portfolio.db
LOG_LEVEL=INFO
LOG_FILE=logs/run.log
DEBUG=false

DATA_PROVIDER=akshare
USE_INSTOCK=false
INSTOCK_PROJECT_PATH=d:/code/stock-deploy
INSTOCK_MYSQL_PASSWORD=
CACHE_DIR=cache
UNIVERSE_SAMPLE_SIZE=20

FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

INITIAL_CAPITAL=200000.0
MIN_STOCK_PRICE=2.0

ENABLE_AI_ANALYSIS=false
ANTHROPIC_API_KEY=

MARKET_WORKER_PROVIDER=akshare
MARKET_UPDATE_TIME=15:35
MARKET_RUN_IMMEDIATELY=true

AGENT_PROVIDER=akshare
AGENT_STRATEGY=momentum
AGENT_POLL_SECONDS=300
AGENT_NOTIFY=true
