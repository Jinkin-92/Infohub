# -*- coding: utf-8 -*-
# InfoHub 环境变量配置
# 复制此文件为 .env 并修改配置

# ========================================
# 后端服务配置
# ========================================
NODE_ENV=production
PORT=3002

# ========================================
# 数据库配置 (SQLite)
# 注意: SQLite 模式下使用 SQLITE_PATH，DATABASE_URL 仅用于 PostgreSQL
# ========================================
SQLITE_PATH=./data/infohub.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/infohub

# ========================================
# RSSHub配置
# ========================================
RSSHUB_URL=http://localhost:1200

# ========================================
# 微信公众号 Cookie (可选)
# 用于采集微信公众号文章
# ========================================
# WECHAT_COOKIE=
# WECHAT_TOKEN=

# ========================================
# 微博 Cookie (可选)
# 用于微博订阅
# ========================================
# WEIBO_COOKIES=

# ========================================
# 日志配置
# ========================================
LOG_LEVEL=info
